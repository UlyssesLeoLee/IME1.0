{
  "schema_version": 1,
  "profile_id": "typescript",
  "version": "1.0.0",
  "display_name": "TypeScript",
  "language_ids": ["typescript", "typescriptreact"],
  "accepted_extensions": [".ts", ".tsx", ".mts", ".cts"],
  "validator": "c-like",
  "dialects": {"mode": {"values": ["ts", "tsx"], "default": "ts"}},
  "keywords": ["function", "interface", "type", "const", "let", "async", "await", "import", "export", "class", "enum", "extends", "implements", "Promise", "return", "readonly", "unknown", "never", "string", "number", "boolean", "undefined", "null", "typeof", "keyof"],
  "triggers": [
    {"id": "ts.fn", "pattern": "fn", "kind": "syntax", "weight": 80, "contexts": ["statement", "expression", "unknown"],
     "candidates": [{"label": "arrow function", "text": "const ${name} = (${value}: ${unknown}): ${void} => {\n  ${cursor}\n};"}]},
    {"id": "ts.function", "pattern": "function", "kind": "syntax", "weight": 75, "contexts": ["statement"],
     "candidates": [{"label": "function", "text": "function ${name}(${args}): ${void} {\n  ${cursor}\n}"}]},
    {"id": "ts.generic.ts", "pattern": "garrow", "kind": "syntax", "weight": 70, "when": {"mode": ["ts"]}, "contexts": ["statement", "unknown"],
     "candidates": [{"label": "generic arrow function", "text": "const ${name} = <T>(value: T): T => value;"}]},
    {"id": "ts.generic.tsx", "pattern": "garrow", "kind": "syntax", "weight": 70, "when": {"mode": ["tsx"]}, "contexts": ["statement", "unknown"],
     "candidates": [{"label": "generic arrow function (TSX: trailing comma)", "explain": "In TSX a bare <T> is parsed as JSX; <T,> is the unambiguous form", "text": "const ${name} = <T,>(value: T): T => value;"}]},
    {"id": "ts.component.tsx", "pattern": "component", "kind": "syntax", "weight": 75, "when": {"mode": ["tsx"]}, "contexts": ["statement"],
     "candidates": [{"label": "React component (TSX)", "text": "const ${Name} = (): JSX.Element => {\n  return <div>${cursor}</div>;\n};"}]},
    {"id": "ts.interface", "pattern": "interface", "kind": "syntax", "weight": 75, "contexts": ["statement"],
     "candidates": [{"label": "interface", "text": "interface ${Name} {\n  ${id}: ${string};\n}"}]},
    {"id": "ts.type", "pattern": "type", "kind": "syntax", "weight": 70, "contexts": ["statement"],
     "candidates": [{"label": "type alias", "text": "type ${Name} = ${string} | ${number};"}]},
    {"id": "ts.async", "pattern": "async", "kind": "syntax", "weight": 65, "contexts": ["statement"],
     "candidates": [{"label": "async function", "text": "async function ${name}(${args}): Promise<${void}> {\n  ${cursor}\n}"}]},
    {"id": "ts.fori", "pattern": "fori", "kind": "syntax", "weight": 70, "contexts": ["statement"],
     "candidates": [{"label": "for-of loop", "text": "for (const ${item} of ${items}) {\n  ${cursor}\n}"}]},
    {"id": "ts.guard", "pattern": "guard", "kind": "syntax", "weight": 55, "contexts": ["statement"],
     "candidates": [{"label": "type guard", "text": "function is${Type}(value: unknown): value is ${Type} {\n  return ${cursor};\n}"}]},
    {"id": "ts.prom", "pattern": "promise", "kind": "syntax", "weight": 55, "contexts": ["type"],
     "candidates": [{"label": "Promise type", "text": "Promise<${T}>"}]},
    {"id": "ts.enum", "pattern": "enum", "kind": "syntax", "weight": 60, "contexts": ["statement"],
     "candidates": [{"label": "enum", "text": "enum ${Name} {\n  ${Member},\n}"}]},
    {"id": "ts.class", "pattern": "class", "kind": "syntax", "weight": 60, "contexts": ["statement"],
     "candidates": [{"label": "class", "text": "class ${Name} {\n  constructor(${args}) {\n    ${cursor}\n  }\n}"}]}
  ]
}
