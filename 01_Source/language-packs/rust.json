{
  "schema_version": 1,
  "profile_id": "rust",
  "version": "1.0.0",
  "display_name": "Rust",
  "language_ids": ["rust"],
  "accepted_extensions": [".rs"],
  "validator": "c-like",
  "dialects": {"edition": {"values": ["2021", "2024"], "default": "2024"}},
  "keywords": ["fn", "let", "mut", "match", "impl", "trait", "struct", "enum", "pub", "use", "mod", "async", "await", "loop", "while", "for", "if", "else", "return", "const", "static", "where", "Result", "Option", "Some", "None", "Ok", "Err", "Vec", "String", "Box", "unsafe", "crate", "self", "Self"],
  "triggers": [
    {"id": "rust.main", "pattern": "fnm", "kind": "syntax", "weight": 95, "contexts": ["statement"],
     "candidates": [{"label": "main function", "explain": "Program entry point", "text": "fn main() {\n    ${cursor}\n}"}]},
    {"id": "rust.fn", "pattern": "fn", "kind": "syntax", "weight": 80, "contexts": ["statement"], "not_in": ["impl", "trait"],
     "candidates": [{"label": "function", "explain": "Free function", "text": "fn ${name}(${args}) {\n    ${cursor}\n}"}]},
    {"id": "rust.method", "pattern": "fn", "kind": "syntax", "weight": 85, "contexts": ["statement"], "in": ["impl", "trait"],
     "candidates": [{"label": "method", "explain": "Method inside impl/trait (nearby text shows an impl block)", "text": "fn ${name}(&self${args}) {\n    ${cursor}\n}"}]},
    {"id": "rust.pubfn", "pattern": "pubfn", "kind": "syntax", "weight": 70, "contexts": ["statement"],
     "candidates": [{"label": "public function", "text": "pub fn ${name}(${args}) {\n    ${cursor}\n}"}]},
    {"id": "rust.async", "pattern": "async", "kind": "syntax", "weight": 60, "contexts": ["statement"],
     "candidates": [{"label": "async function", "text": "async fn ${name}(${args}) -> ${Ret} {\n    ${cursor}\n}"}]},
    {"id": "rust.fori", "pattern": "fori", "kind": "syntax", "weight": 75, "contexts": ["statement"],
     "candidates": [{"label": "iterator loop", "text": "for ${item} in ${items}.iter() {\n    ${cursor}\n}"}]},
    {"id": "rust.match", "pattern": "match", "kind": "syntax", "weight": 80, "contexts": ["statement", "expression", "unknown"],
     "candidates": [{"label": "match expression", "explain": "No trailing semicolon: a match may be an expression or a statement", "text": "match ${value} {\n    ${pattern} => ${expr},\n    _ => {}\n}"}]},
    {"id": "rust.iflet", "pattern": "iflet", "kind": "syntax", "weight": 70, "contexts": ["statement"],
     "candidates": [{"label": "if let Some", "text": "if let Some(${value}) = ${option} {\n    ${cursor}\n}"}]},
    {"id": "rust.impl", "pattern": "impl", "kind": "syntax", "weight": 75, "contexts": ["statement"], "not_in": ["impl", "trait", "fn"],
     "candidates": [{"label": "impl block", "text": "impl ${Type} {\n    ${cursor}\n}"}]},
    {"id": "rust.implfor", "pattern": "implfor", "kind": "syntax", "weight": 65, "contexts": ["statement"], "not_in": ["impl", "trait", "fn"],
     "candidates": [{"label": "trait impl", "text": "impl ${Trait} for ${Type} {\n    ${cursor}\n}"}]},
    {"id": "rust.trait", "pattern": "trait", "kind": "syntax", "weight": 65, "contexts": ["statement"],
     "candidates": [{"label": "trait", "text": "trait ${Name} {\n    ${cursor}\n}"}]},
    {"id": "rust.enum", "pattern": "enum", "kind": "syntax", "weight": 65, "contexts": ["statement"],
     "candidates": [{"label": "enum", "text": "enum ${Name} {\n    ${Variant},\n}"}]},
    {"id": "rust.struct", "pattern": "struct", "kind": "syntax", "weight": 65, "contexts": ["statement"],
     "candidates": [{"label": "struct", "text": "struct ${Name} {\n    ${field}: ${Type},\n}"}]},
    {"id": "rust.result", "pattern": "result", "kind": "syntax", "weight": 60, "contexts": ["type"],
     "candidates": [{"label": "Result type", "text": "Result<${T}, ${E}>"}]},
    {"id": "rust.option", "pattern": "option", "kind": "syntax", "weight": 60, "contexts": ["type"],
     "candidates": [{"label": "Option type", "text": "Option<${T}>"}]},
    {"id": "rust.test", "pattern": "test", "kind": "syntax", "weight": 55, "contexts": ["statement"],
     "candidates": [{"label": "unit test", "text": "#[test]\nfn ${name}() {\n    ${cursor}\n}"}]},
    {"id": "rust.println", "pattern": "println", "kind": "syntax", "weight": 70, "contexts": ["statement", "expression", "unknown"],
     "candidates": [{"label": "println! macro", "explain": "A trailing semicolon is added only where the position is provably a statement", "text": "println!(\"${message}\");", "stmt_semicolon": true}]},
    {"id": "rust.unsafe_extern.2024", "pattern": "extern", "kind": "syntax", "weight": 40, "contexts": ["statement"], "when": {"edition": ["2024"]},
     "candidates": [{"label": "unsafe extern block (edition 2024)", "text": "unsafe extern \"C\" {\n    ${cursor}\n}"}]},
    {"id": "rust.extern.2021", "pattern": "extern", "kind": "syntax", "weight": 40, "contexts": ["statement"], "when": {"edition": ["2021"]},
     "candidates": [{"label": "extern block (edition 2021)", "text": "extern \"C\" {\n    ${cursor}\n}"}]}
  ]
}
