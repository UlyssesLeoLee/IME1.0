  "dialects": {"std": {"values": ["c11", "c17", "c23"], "default": "c17"}},
  "keywords": ["int", "char", "void", "struct", "typedef", "enum", "union", "static", "const", "sizeof", "return", "unsigned", "signed", "long", "short", "float", "double", "switch", "case", "default", "break", "continue", "while", "for", "if", "else", "goto", "extern", "volatile", "printf", "malloc", "free", "size_t"],
  "triggers": [
    {"id": "c.main", "pattern": "main", "kind": "syntax", "weight": 90, "contexts": ["statement"],
     "candidates": [{"label": "main function", "text": "int main(void) {\n    ${cursor}\n    return 0;\n}"}]},
    {"id": "c.fori", "pattern": "fori", "kind": "syntax", "weight": 75, "contexts": ["statement"],
     "candidates": [{"label": "for loop", "text": "for (size_t ${i} = 0; ${i} < ${count}; ++${i}) {\n    ${cursor}\n}"}]},
    {"id": "c.struct", "pattern": "struct", "kind": "syntax", "weight": 70, "contexts": ["statement"],
     "candidates": [{"label": "struct", "text": "struct ${Name} {\n    ${int} ${value};\n};"}]},
    {"id": "c.typedef", "pattern": "typedef", "kind": "syntax", "weight": 65, "contexts": ["statement"],
     "candidates": [{"label": "typedef struct", "text": "typedef struct {\n    ${int} ${value};\n} ${Name};"}]},
    {"id": "c.include", "pattern": "include", "kind": "syntax", "weight": 70, "contexts": ["statement"],
     "candidates": [{"label": "include header", "text": "#include <${stdio.h}>"}]},
    {"id": "c.guard", "pattern": "ifndef", "kind": "syntax", "weight": 60, "contexts": ["statement"],
     "candidates": [{"label": "header guard", "text": "#ifndef ${HEADER_H}\n#define ${HEADER_H}\n\n${cursor}\n\n#endif"}]},
    {"id": "c.fnptr", "pattern": "fnptr", "kind": "syntax", "weight": 55, "contexts": ["statement"],
     "candidates": [{"label": "function pointer", "text": "${char} (*${fn})(${void});"}]},
    {"id": "c.array", "pattern": "array", "kind": "syntax", "weight": 55, "contexts": ["statement"],
     "candidates": [{"label": "array declaration", "text": "${int} ${name}[${size}];"}]},
    {"id": "c.static_assert.11", "pattern": "staticassert", "kind": "syntax", "weight": 50, "when": {"std": ["c11", "c17"]}, "contexts": ["statement"],
     "candidates": [{"label": "_Static_assert (C11/C17)", "text": "_Static_assert(${cond}, \"${message}\");"}]},
    {"id": "c.static_assert.23", "pattern": "staticassert", "kind": "syntax", "weight": 50, "when": {"std": ["c23"]}, "contexts": ["statement"],
     "candidates": [{"label": "static_assert (C23 keyword)", "text": "static_assert(${cond}, \"${message}\");"}]},
    {"id": "c.constexpr.23", "pattern": "constexpr", "kind": "syntax", "weight": 50, "when": {"std": ["c23"]}, "contexts": ["statement"],
     "candidates": [{"label": "constexpr object (C23)", "text": "constexpr ${int} ${NAME} = ${value};"}]},
    {"id": "c.nullptr.23", "pattern": "nullptr", "kind": "syntax", "weight": 50, "when": {"std": ["c23"]}, "contexts": ["expression", "unknown"],
     "candidates": [{"label": "nullptr (C23)", "text": "nullptr"}]}
  ]
